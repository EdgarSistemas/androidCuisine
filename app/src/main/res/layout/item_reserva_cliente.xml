<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardReserva"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: ID + Estatus -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvIdReserva"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reserva #10"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/cuisine_dark_text"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEstatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Programada"
                android:textSize="12sp"
                app:chipMinHeight="28dp"/>

        </LinearLayout>

        <!-- Fecha -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📅 2025-12-03"
            android:textSize="14sp"
            android:textColor="@color/cuisine_dark_text"/>

        <!-- Horario -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvHorario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🕐 14:00 - 16:00"
            android:textSize="14sp"
            android:textColor="@color/cuisine_gray"/>

        <!-- Notas -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvNotas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📝 Notas"
            android:textSize="12sp"
            android:textColor="@color/cuisine_gray"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/cuisine_gray_light"/>

        <!-- Botones de acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Cancelar"
                android:textSize="12sp"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.TextButton"
                android:textColor="@color/cuisine_red"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCompletar"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Completar"
                android:textSize="12sp"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.TonalButton"
                app:backgroundTint="@color/cuisine_green_light"
                android:textColor="@color/cuisine_green_dark"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrdenar"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="🍽️ Ordenar"
                android:textSize="12sp"
                android:visibility="gone"
                style="@style/Widget.Material3.Button"
                app:backgroundTint="@color/cuisine_purple"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciar"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Iniciar"
                android:textSize="12sp"
                android:visibility="gone"
                style="@style/Widget.Material3.Button"
                app:backgroundTint="@color/cuisine_orange"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>