<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cuisine_beige_background"
    tools:context=".views.auth.ValidateCodeActivity">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_menu_home"
        app:tint="@color/cuisine_dark_text"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Regresar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verificar Código"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/cuisine_dark_text"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvValidateInstructions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Introduce el código de 6 dígitos enviado a tu correo."
            android:textSize="16sp"
            android:textColor="@color/cuisine_dark_text"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilValidationCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxStrokeColor="@color/cuisine_green_dark"
            app:hintTextColor="@color/cuisine_green_dark"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:hint="Código de Verificación">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputValidationCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="6"
                android:gravity="center"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnValidateCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Validar y Enviar"
            android:backgroundTint="@color/cuisine_green_dark"
            android:textColor="@color/white"
            android:paddingVertical="14dp"
            app:cornerRadius="8dp"
            android:layout_marginTop="32dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>