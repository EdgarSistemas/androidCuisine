<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cuisine_beige_background">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reservas"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/cuisine_dark_text"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="20dp"/>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/cuisine_beige_background"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/cuisine_green_dark"
        app:tabSelectedTextColor="@color/cuisine_green_dark"
        app:tabTextColor="@color/cuisine_dark_text"
        app:tabIndicatorHeight="3dp"
        app:tabRippleColor="@color/cuisine_green_light"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>