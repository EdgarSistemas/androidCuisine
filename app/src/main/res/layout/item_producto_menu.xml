<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Categoría -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hamburguesas"
                android:textSize="11sp"
                android:textColor="@color/cuisine_orange"
                android:textAllCaps="true"/>

            <!-- Nombre -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Hamburguesa Clásica"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/cuisine_dark_text"/>

            <!-- Descripción -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Carne, lechuga, tomate, queso"
                android:textSize="12sp"
                android:textColor="@color/cuisine_gray"
                android:maxLines="2"
                android:ellipsize="end"/>

            <!-- Precio -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="$85.00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/cuisine_green_dark"/>

        </LinearLayout>

        <!-- Botón Agregar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregar"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:backgroundTint="@color/cuisine_orange_light"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>