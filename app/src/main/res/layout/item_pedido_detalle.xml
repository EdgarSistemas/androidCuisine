<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvCantidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2x"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/cuisine_green_dark"
        android:minWidth="32dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hamburguesa Clásica"
            android:textSize="14sp"
            android:textColor="@color/cuisine_dark_text"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvNotas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sin cebolla"
            android:textSize="12sp"
            android:textColor="@color/cuisine_dark_text"
            android:alpha="0.6"
            android:fontStyle="italic"
            android:visibility="gone"/>

    </LinearLayout>

    <com.google.android.material.chip.Chip
        android:id="@+id/chipEstadoItem"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:text="En cocina"
        android:textSize="10sp"
        app:chipMinHeight="24dp"
        app:chipCornerRadius="12dp"
        app:chipStrokeWidth="0dp"/>

</LinearLayout>