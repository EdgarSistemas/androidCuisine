<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPedido"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: ID + Estatus -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvIdPedido"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pedido #123"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/cuisine_dark_text"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEstatus"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Pendiente"
                android:textSize="11sp"
                app:chipMinHeight="28dp"
                app:chipCornerRadius="14dp"/>

        </LinearLayout>

        <!-- Tipo -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🍽️ Comer aquí"
            android:textSize="13sp"
            android:textColor="@color/cuisine_dark_text"
            android:alpha="0.8"/>

        <!-- Fecha -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📅 2025-12-15 19:00"
            android:textSize="13sp"
            android:textColor="@color/cuisine_dark_text"
            android:alpha="0.6"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/cuisine_gray_light"/>

        <!-- Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total"
                android:textSize="14sp"
                android:textColor="@color/cuisine_gray"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$150.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/cuisine_orange"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>