<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cuisine_beige_background"
    android:padding="32dp"
    tools:context=".views.auth.PermisosObligatoriosActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_menu_home"
            app:tint="@color/cuisine_green_dark"
            android:layout_marginBottom="24dp"
            android:contentDescription="Icono de advertencia" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permisos Requeridos"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/cuisine_dark_text"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Para poder usar la aplicación, es **obligatorio** aceptar los permisos de Cámara, Almacenamiento e Internet. Por favor, acéptalos y reinicia la aplicación."
            android:textSize="16sp"
            android:textColor="@color/cuisine_dark_text"
            android:alpha="0.8"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReintentarPermisos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reintentar y Verificar"
            android:backgroundTint="@color/cuisine_green_dark"
            android:textColor="@color/white"
            android:paddingVertical="14dp"
            app:cornerRadius="8dp"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarApp"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar Aplicación"
            android:textColor="#D32F2F"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>